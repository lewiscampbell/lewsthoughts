---
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A personal notebook of thoughts, articles, and pictures." } = Astro.props;
const fullTitle = title === "Home" ? "lewsthoughts" : `${title} · lewsthoughts`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0T2YJ4K9R0"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-0T2YJ4K9R0');
        </script>
      </>
    )}
  </head>
  <body>
    <div class="site-shell">
      <Sidebar />
      <div class="site-content">
        <slot />
      </div>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
