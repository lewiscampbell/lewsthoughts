---
import { getBlogPosts } from '../lib/contentful';

const posts = await getBlogPosts();
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const articlesOpen = currentPath.startsWith('/articles/');

function isHome() {
  return currentPath === '/';
}

function isArticle(slug: string) {
  return currentPath === `/articles/${slug}`;
}
---

<aside class="sidebar">
  <div class="sidebar__top">
    <a href="/" class="site-logo">lewsthoughts</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>

  <div id="site-menu" class="sidebar__menu">
  <nav aria-label="Main">
    <ul class="site-nav">
      <li>
        <a href="/" aria-current={isHome() ? 'page' : undefined}>Home</a>
      </li>
      <li>
        <button
          class="articles-toggle"
          type="button"
          aria-expanded={articlesOpen ? 'true' : 'false'}
          aria-controls="article-list"
        >
          Articles
          <svg class="articles-toggle__icon" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2.2 4.3 6 8.1 9.8 4.3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </li>
    </ul>

    <ul id="article-list" class="article-menu" hidden={!articlesOpen}>
      {posts.length === 0 ? (
        <li class="article-menu__empty">Nothing here yet.</li>
      ) : (
        posts.map((post) => (
          <li>
            <a
              href={`/articles/${post.slug}/`}
              aria-current={isArticle(post.slug) ? 'page' : undefined}
              data-description={post.description}
              data-image={post.heroImageUrl}
              data-image-alt={post.heroImageAlt ?? post.title}
            >
              {post.title}
            </a>
          </li>
        ))
      )}
    </ul>
  </nav>

  <div class="article-preview" hidden role="tooltip">
    <img alt="" />
    <p></p>
  </div>

  <ul class="sidebar__socials">
    <li>
      <a href="https://www.instagram.com/campbelllllll/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z" />
        </svg>
      </a>
    </li>
    <li>
      <a href="https://www.youtube.com/channel/UC_NDmVdG5A-Dai7_GZAUHQA" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.87.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12z" />
        </svg>
      </a>
    </li>
    <li>
      <a href="https://open.spotify.com/artist/5udgXJYWwK7cchnPSKqEkK" target="_blank" rel="noopener noreferrer" aria-label="Spotify">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14C9.6 9.9 15 10.56 18.72 12.84c.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z" />
        </svg>
      </a>
    </li>
    </ul>
  </div>
</aside>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');

  navToggle?.addEventListener('click', () => {
    const menu = document.querySelector('#site-menu');
    const bar = document.querySelector<HTMLElement>('.sidebar__top');
    const open = navToggle.getAttribute('aria-expanded') === 'true';
    const nextOpen = !open;
    if (bar) {
      document.documentElement.style.setProperty('--phone-bar-height', `${bar.offsetHeight}px`);
    }
    navToggle.setAttribute('aria-expanded', String(nextOpen));
    navToggle.setAttribute('aria-label', nextOpen ? 'Close menu' : 'Open menu');
    menu?.classList.toggle('is-open', nextOpen);
    document.body.classList.toggle('nav-open', nextOpen);
  });

  const toggle = document.querySelector<HTMLButtonElement>('.articles-toggle');
  const list = document.querySelector<HTMLElement>('#article-list');
  const preview = document.querySelector<HTMLElement>('.article-preview');
  const previewImage = preview?.querySelector('img');
  const previewText = preview?.querySelector('p');

  toggle?.addEventListener('click', () => {
    if (!list || !preview) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    list.hidden = open;
    if (open) preview.hidden = true;
  });

  let hideTimer = 0;
  const phoneLayout = window.matchMedia('(max-width: 800px)');

  function hidePreviewSoon(event?: Event) {
    const next = event instanceof MouseEvent ? event.relatedTarget : null;
    if (next instanceof Node && preview?.contains(next)) return;
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => {
      if (preview) preview.hidden = true;
    }, 160);
  }

  function showPreview(link: HTMLAnchorElement) {
    if (phoneLayout.matches || !preview || !previewImage || !previewText || list?.hidden) return;
    window.clearTimeout(hideTimer);

    const image = link.dataset.image;
    const description = link.dataset.description ?? '';
    if (image) {
      previewImage.src = image;
      previewImage.alt = link.dataset.imageAlt ?? '';
      previewImage.hidden = false;
    } else {
      previewImage.hidden = true;
      previewImage.removeAttribute('src');
    }
    previewText.textContent = description;
    preview.hidden = false;

    const rect = link.getBoundingClientRect();
    const sidebarRight = link.closest('.sidebar')?.getBoundingClientRect().right ?? rect.right;
    const width = preview.offsetWidth;
    const height = preview.offsetHeight;
    let left = sidebarRight + 12;
    let top = rect.top + rect.height / 2 - height / 2;

    if (left + width > window.innerWidth - 12) {
      left = Math.max(12, window.innerWidth - width - 12);
      top = rect.bottom + 10;
    }

    top = Math.max(12, Math.min(top, window.innerHeight - height - 12));
    preview.style.left = `${left}px`;
    preview.style.top = `${top}px`;
  }

  document.querySelectorAll<HTMLAnchorElement>('.article-menu a').forEach((link) => {
    link.addEventListener('mouseenter', () => showPreview(link));
    link.addEventListener('focus', () => showPreview(link));
    link.addEventListener('mouseleave', hidePreviewSoon);
    link.addEventListener('blur', () => hidePreviewSoon());
  });

  preview?.addEventListener('mouseenter', () => window.clearTimeout(hideTimer));
  preview?.addEventListener('mouseleave', hidePreviewSoon);
  phoneLayout.addEventListener('change', () => {
    if (phoneLayout.matches && preview) preview.hidden = true;
  });
</script>
