---
interface Props {
  title: string;
  slug: string;
  tag: string;
  image: string;
  alt?: string;
  date: string;
  description: string;
}

const { title, slug, tag, image, alt, date, description } = Astro.props;
---

<article class="article-card">
  <a href={`/blog/${slug}/`} class="article-card__link">
    <div class="article-card__image">
      <img src={image} alt={alt ?? title} loading="lazy" decoding="async" />
    </div>
    <h3 class="article-card__title">{title}</h3>
    <p class="article-card__date">{date}</p>
    <p class="article-card__description">{description}</p>
    <span class="article-card__tag">{tag}</span>
  </a>
</article>
